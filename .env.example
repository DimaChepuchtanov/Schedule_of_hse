# =========================================
# Настройка доступа к базе данных PostgreSQL
# =========================================

PG_USER = your_user
PG_PASSWORD = your_password
PG_HOST = your_hosr
PG_PORT = your_port
PG_DATABASE = your_db


# =========================================
#  Настройка окружения
# =========================================
SECRET_KEY=your_key
DJANGO_SETTINGS_MODULE=...
DJANGO_ALLOWED_HOSTS=...
DJANGO_CSRF_TRUSTED_ORIGINS=...
DJANGO_COOKIE_SECURE=...